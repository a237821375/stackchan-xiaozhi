{
    "manufacturer": "m5stack",
    "type": "m5stack-stackchan-k151",
    "target": "esp32s3",
    "builds": [
        {
            "name": "m5stack-stackchan-k151",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": false
            },
            "sdkconfig_append": [
                "CONFIG_USE_AUDIO_PROCESSOR=y",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_USE_SERVER_AEC=n",
                "CONFIG_SPIRAM_MODE_QUAD=y",
                "CONFIG_CAMERA_GC0308=y",
                "CONFIG_CAMERA_GC0308_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_GC0308_DVP_YUV422_320X240_20FPS=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y"
            ]
        }
    ]
}
